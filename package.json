{
  "name": "pi-v4-jspace",
  "version": "1.0.0",
  "description": "DeepSeek V4 Minimal Anchor + J-Space runtime integration for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "deepseek",
    "deepseek-v4",
    "j-space",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src/**/*.ts",
    "skills/**/*",
    "vendor-meta/**/*.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
